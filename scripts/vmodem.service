# ===========================================================================
#  vmodem.service -- VModem を systemd 管理下で常駐させる (Step 8)
#
#  配置先: /etc/systemd/system/vmodem.service
#  反映  : sudo systemctl daemon-reload
#
#  起動のきっかけは 2 通り:
#    (a) 99-vmodem.rules の ENV{SYSTEMD_WANTS} により
#        /dev/ttyGS0 出現時に udev から自動起動される (既定の運用)
#    (b) 手動:  sudo systemctl start vmodem
#    常時有効化: sudo systemctl enable vmodem   ← ガジェットも
#                自前で用意する場合のみ推奨
# ===========================================================================

[Unit]
Description=VModem - ダイアルアップモデムエミュレータ (/dev/ttyGS0)
Documentation=https://github.com/cheattoolymt/WinDialupEmu

# ポートが無ければ起動しても意味がないので、デバイスの出現を待つ。
#   /dev/ttyGS0 に対応する device unit 名は dev-ttyGS0.device。
After=dev-ttyGS0.device
Requires=dev-ttyGS0.device
# デバイスが消えたら (ガジェット teardown / USB 抜線) 一緒に止める。
BindsTo=dev-ttyGS0.device

After=network.target

[Service]
Type=simple

# --net slirp は raw socket ではなくユーザ空間 NAT なので
# 本来 root は不要だが、/dev/ttyGS0 の権限と
# ホスト経路の設定 (Step 5) のために root で動かすのが簡単。
User=root

# ---------------------------------------------------------------------------
#  ICMP (ゲストからの ping) を通すために必要な権限
# ---------------------------------------------------------------------------
#  libslirp は ICMP を 2 段構えで扱う (src/ip_icmp.c icmp_send):
#    1 段目 SOCK_DGRAM+IPPROTO_ICMP -> net.ipv4.ping_group_range 次第
#    2 段目 SOCK_RAW+IPPROTO_ICMP   -> CAP_NET_RAW が必要
#  両方失敗すると icmp_send() は -1 を返し、ゲストの ICMP Echo は
#  ログも出さずに捨てられる (= ping だけ無応答, TCP/UDP は正常)。
#
#  User=root なら CAP_NET_RAW は元から持っているので下記は冗長だが、
#  明示しておく事に 2 つの意味がある:
#    (1) 将来 User= を非 root に変えた時に静かに壊れない
#        (AmbientCapabilities は非 root プロセスにも権限を渡せる)
#    (2) NoNewPrivileges 等の強化オプションを足した時に
#        「何が必要か」が unit を見れば分かる
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# ping_group_range は sysctl なので **再起動でリセットされる**。
# 恒久化は /etc/sysctl.d/99-vmodem.conf が担うが、
# udev 起動など sysctl.d の適用前に立ち上がる経路もあるため、
# ここでも念のため当てておく (失敗しても '-' で起動は続行)。
ExecStartPre=-/usr/bin/env sh -c 'echo "0 2147483647" > /proc/sys/net/ipv4/ping_group_range'

# ExecStartPre: ガジェットがまだ無い状況 (手動 start など) でも
#   立ち上がるように、べき等なセットアップを一度呼ぶ。
#   既に bind 済みなら何もせず 0 で返る。
#   '-' 接頭辞により失敗しても起動は続行する。
ExecStartPre=-/usr/local/bin/vmodem-setup-gadget

ExecStart=/usr/local/bin/vmodem \
    --config /etc/vmodem/config.ini \
    --port /dev/ttyGS0 \
    --net slirp \
    -v

# vmodem は SIGTERM を受けると PPP を切ってから終了する
# (Step 3 で実装済みのシグナルハンドラ経路)。
KillSignal=SIGTERM
TimeoutStopSec=10

Restart=on-failure
RestartSec=2

# ログは journald へ。
#   sudo journalctl -u vmodem -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
