# ビルド成果物
build/
build-*/

# Linux ビルドの実行ファイル (Makefile.linux の TARGET)
#   拡張子が無いので明示的に書く必要がある。
#   先頭の "/" でリポジトリ直下だけを対象にする。
/vmodem
*.d
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.pdb
*.ilk

# クラッシュダンプ
# 先頭の "/" は必須。"core" と書くと src/core/ ディレクトリごと無視され、
# src/core/*.c がコミットから漏れる (実際に漏れていた)。
/core
/core.*
*.stackdump

# 実行時に生成されるもの
*.log
*.wav
!docs/**/*.wav

# エディタ / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# 外部 OSS の展開先 (scripts/ が取得する)
third_party/*/
!third_party/README.md
